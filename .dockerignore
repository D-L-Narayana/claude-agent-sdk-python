# Git
.git
.gitignore

# Python. Dockerignore patterns are anchored to the build context root, so a
# bare `__pycache__` only matches the root one; `**/` matches at any depth.
**/__pycache__
**/*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing/Coverage
.coverage
.coverage.*
coverage.xml
.pytest_cache/
htmlcov/
.tox/
.nox/

# Linting/Type checking
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Local env files (live-backend test credentials etc.): never into an image layer
.env.*

# Claude Code worktrees (full checkouts; see .gitignore)
.claude/worktrees/

# Misc
*.log
.DS_Store
